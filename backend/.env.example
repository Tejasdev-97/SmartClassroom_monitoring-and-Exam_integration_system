# ExamProctor.ai Backend — Environment Variables

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_BEFORE_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://examproctor:examproctor@localhost:5432/examproctor
SYNC_DATABASE_URL=postgresql+psycopg2://examproctor:examproctor@localhost:5432/examproctor

# ─── CORS (comma-separated list of allowed origins) ───────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Smart Classroom Monitoring Database ───────────────────────────────────────
# Default: SQLite in local development (sqlite:///./storage/classroom.db)
# Production: set to PostgreSQL connection string (e.g., matching DATABASE_URL)
# CLASSROOM_DATABASE_URL=postgresql+psycopg2://examproctor:examproctor@localhost:5432/examproctor

# ─── Evidence Storage (Neon Object Storage / S3 / Local) ───────────────────────
# Storage backend: 'local' (development fallback) or 's3' / 'neon' (Neon Object Storage / AWS S3)
SNAPSHOT_STORAGE_TYPE=local
CLIP_STORAGE_BACKEND=local
SNAPSHOT_LOCAL_DIR=./storage/snapshots
CLIP_LOCAL_DIR=./storage/clips
MAX_SNAPSHOT_SIZE_BYTES=5242880
CLIP_MAX_BYTES=15728640

# Neon Object Storage / S3 configuration:
# When SNAPSHOT_STORAGE_TYPE=neon or CLIP_STORAGE_BACKEND=neon (or s3):
# NEON_OBJECT_STORAGE_ENDPOINT=https://<project-id>.s3.neon.tech
# NEON_OBJECT_STORAGE_ACCESS_KEY_ID=your_neon_storage_access_key
# NEON_OBJECT_STORAGE_SECRET_ACCESS_KEY=your_neon_storage_secret_key
# NEON_OBJECT_STORAGE_REGION=ap-southeast-1
# NEON_SNAPSHOT_BUCKET=examproctor-snapshots
# NEON_CLIP_BUCKET=examproctor-clips
# (Also accepts AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_ENDPOINT_URL)

# ─── WebRTC ICE Infrastructure (STUN / TURN) ───────────────────────────────────
# STUN default uses Google public STUN; specify comma-separated list if custom.
STUN_SERVER_URL=stun:stun.l.google.com:19302
# Optional TURN server for NAT/symmetric firewall traversal in classrooms
# TURN_SERVER_URL=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=classroom-relay
# TURN_CREDENTIAL=secure-turn-credential

# ─── Student Agent Offline Authorization Lease (Ed25519) ───────────────────────
# Base64-encoded 32-byte Ed25519 private key seed used to sign student agent leases.
# In dev, auto-generated and stored in ./storage/lease_signing_key.
# In production, set this secret so leases survive container restarts and work across replicas.
# LEASE_SIGNING_KEY=

# ─── Excel import ──────────────────────────────────────────────────────────────
MAX_EXCEL_SIZE_BYTES=10485760
MAX_EXCEL_ROWS=500

# ─── Admin bootstrap (used once to seed first admin account) ───────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@examproctor.ai
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_BEFORE_PRODUCTION

